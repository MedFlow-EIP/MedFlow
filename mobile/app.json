{
  "expo": {
    "name": "medflow-learning",
    "slug": "medflow-learning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "medflow",
      "com.wavitooo.medflowlearning"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02a195"
      },
      "package": "com.wavitooo.medflowlearning"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "MedFlow utilise le micro pour dicter tes questions à l’assistant."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedFlow utilise l’appareil photo pour importer une page de cours.",
          "photosPermission": "MedFlow accède à tes photos pour importer un cours ou changer ton avatar."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "435ebee3-03ff-4495-9275-0eca11ec1fed"
      }
    }
  }
}
